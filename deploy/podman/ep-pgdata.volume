# F-57：HISTORICAL_LINUX_RESEARCH_ONLY；禁止用于当前 Windows Server 2022 生产部署或发布验收。
# ep-pgdata：事务数据库的数据目录，规格第 13.1 章 PostgreSQL 16 单实例的落盘处。
# VolumeName= 固定卷名，不取 Quadlet 默认的 systemd- 前缀；Compose 一侧同名 volume 写 name: ep-pgdata，
# 两套据此落在同一个卷上，等价性核对脚本比对的就是这个名字。需 Podman 5.0 及以上。
[Volume]
VolumeName=ep-pgdata

[Install]
WantedBy=multi-user.target
