# F-57：HISTORICAL_LINUX_RESEARCH_ONLY；禁止用于当前 Windows Server 2022 生产部署或发布验收。
# PostgreSQL 16，规格第 13.1 章的事务数据库单实例。
# 建库参数不在此处取值：ADR-0003 已把 CREATE DATABASE 的 collation 与编码交给
# db/bootstrap/00_database.sql，该脚本按裁定 C-01 由阶段 2 交付。这里给一个 POSTGRES_INITDB_ARGS
# 就是第二套取值，与该 ADR 直接冲突，因此本单元只起集群、不定义库。
[Unit]
Description=EP 单机部署：PostgreSQL 16

[Container]
ContainerName=ep-postgres
Image=docker.io/library/postgres:16
# 全部组件同机，且技术基线第 2 节的监听地址一律是 127.0.0.1；主机网络下这些取值原样成立，
# 无须发布端口，也不会有任何一个监听意外可从网络到达。规格第 13.1 章已声明门户与核心之间
# 只有进程与系统账户边界、不是网段边界，主机网络不改变该结论。
Network=host
Volume=ep-pgdata.volume:/var/lib/postgresql/data
Volume=/var/lib/ep/secrets/postgres-superuser:/run/secrets/postgres-superuser:ro
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-superuser
# 官方镜像的入口点要以 root 起再 setuid 到 postgres，DropCapability=ALL 会让它起不来，
# 因此本容器不丢弃能力；其余八个容器一律丢弃。
NoNewPrivileges=true
HealthCmd=pg_isready -U postgres
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6

[Service]
Slice=app-db.slice
Restart=always
# 配置键 http.shutdown_drain_ms 默认 30000，交付物 D-02 要求 SIGTERM 后 30 秒内退出；
# 45 秒是给这 30 秒留的余量，不是第二个排空时长，见 ORCHESTRATION.md 的缺口三。
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
