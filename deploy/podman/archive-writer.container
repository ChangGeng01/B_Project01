# archive-writer：事务日志连续归档、附件正文增量写出、审计证据写出，三项各不超过 15 分钟周期。
# 本进程只读附件正文以产生服务器之外的副本，故 ep-files 挂只读；
# 服务器之外落点本身是客户侧的挂载，本编排不代客户指派，见 ORCHESTRATION.md 的缺口四。
[Unit]
Description=EP 单机部署：archive-writer
Requires=postgres.service core-server.service
After=postgres.service core-server.service

[Container]
ContainerName=ep-archive-writer
Image=localhost/ep/archive-writer:0.1.0
Network=host
Volume=/etc/ep:/etc/ep:ro
Volume=/var/lib/ep/secrets:/var/lib/ep/secrets:ro
Volume=ep-ipc.volume:/run/ep/ipc
Volume=ep-files.volume:/var/lib/ep/files:ro
Volume=ep-spool-archive.volume:/var/lib/ep/archive-writer/spool
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Slice=app-archive.slice
Restart=always
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
