# F-57：HISTORICAL_LINUX_RESEARCH_ONLY；禁止用于当前 Windows Server 2022 生产部署或发布验收。
# ops-agent：运维中心的采集与暴露，指标与健康端点。
# 与反向代理同处 app-edge.slice；反向代理本身在本仓库无镜像来源，见 ORCHESTRATION.md 的缺口二。
[Unit]
Description=EP 单机部署：ops-agent
Requires=postgres.service
After=postgres.service

[Container]
ContainerName=ep-ops-agent
Image=localhost/ep/ops-agent:0.1.0
Network=host
Volume=/etc/ep:/etc/ep:ro
Volume=/var/lib/ep/secrets:/var/lib/ep/secrets:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Slice=app-edge.slice
Restart=always
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
